{
  "manifest_version": 3,
  "name": "FreeDM Integration",
  "version": "0.1.0",
  "description": "Hand downloads from your browser to FreeDM, the free and open source download manager.",
  "homepage_url": "https://github.com/Bloxive/freedm",

  "background": { "service_worker": "background.js" },

  "action": {
    "default_title": "FreeDM",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },

  "options_ui": { "page": "options.html", "open_in_tab": true },

  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "notifications"
  ],

  "host_permissions": ["http://127.0.0.1/*"],

  "optional_host_permissions": ["<all_urls>"]
}
